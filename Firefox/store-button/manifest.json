{
  "manifest_version": 3,
  "name": "Viaduct Install",
  "version": "0.0.0",
  "description": "Install Chrome extensions in Firefox via Viaduct",
  "icons": { "48": "icon.png" },
  "browser_specific_settings": {
    "gecko": { "id": "store-button@viaduct.magicelklabs.com", "strict_min_version": "128.0" }
  },
  "content_scripts": [
    { "matches": ["*://chromewebstore.google.com/*"], "js": ["transport.js", "content.js"], "run_at": "document_start" }
  ],
  "background": { "scripts": ["background.js"] },
  "permissions": ["nativeMessaging"]
}
