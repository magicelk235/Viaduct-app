# Anchored so it only ignores the xcodebuild output at the repo root.
/build/
DerivedData/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
.DS_Store
.build/

# Bundled node runtime — fetched at build by Resources/bin/fetch-node.sh, not committed.
Resources/bin/node

